# Bu dosyayı ".env" adıyla kopyala ve doldur.
#   cp .env.example .env
# .env dosyası git'e GİRMEZ (.gitignore'da).

# --- Telegram (telefondan kontrol için — zorunlu) ---
# @BotFather ile bot oluştur, token'ı buraya yapıştır.
TELEGRAM_TOKEN=
# @userinfobot'a mesaj at, sana ID'ni söyler.
TELEGRAM_CHAT_ID=

# --- FreqUI web arayüzü (tarayıcıdan giriş bilgileri) ---
FREQUI_USERNAME=tradedair
FREQUI_PASSWORD=degistir-beni
# Aşağıdaki ikisini rastgele üret:
#   openssl rand -hex 32
FREQUI_JWT_SECRET=
FREQUI_WS_TOKEN=

# --- Lovable arayüzü (opsiyonel) ---
# Sadece Lovable'dan kendi arayüzünü yapacaksan doldur.
# Bu alan adı sunucunun IP'sine yönlendirilmiş olmalı (A kaydı).
# Caddy sertifikayı otomatik alır.
API_DOMAIN=bot.senindomainin.com

# --- Çalışma ayarları ---
# Bunlar config.json yerine burada tutulur ki "git pull" çakışmasın.
# Değiştirmek için ./scripts/golive.sh kullan (ya da elle düzenle).
DRY_RUN=true
STAKE_AMOUNT=100
MAX_OPEN_TRADES=3
DRY_RUN_WALLET=500

# --- Bybit API anahtarları ---
# TEST MODUNDA BOŞ BIRAK. Sadece canlıya geçerken doldurulur.
# Anahtarı oluştururken "Withdraw" (para çekme) yetkisini ASLA verme.
BYBIT_API_KEY=
BYBIT_API_SECRET=
