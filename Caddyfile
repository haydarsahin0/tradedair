# Lovable arayüzü için HTTPS reverse proxy.
#
# Tarayıcılar https:// sayfadan http:// adrese istek atmayı engeller
# (mixed content). Lovable uygulaman https üzerinde çalıştığı için
# freqtrade API'sinin de https olması gerekir.
#
# Caddy sertifikayı Let's Encrypt'ten otomatik alır ve yeniler —
# tek şart, alan adının bu sunucuya yönlendirilmiş olması.
#
# .env içindeki API_DOMAIN değişkenini kendi alan adınla doldur:
#   API_DOMAIN=bot.senindomainin.com

{$API_DOMAIN} {
	reverse_proxy freqtrade:8080

	header {
		Strict-Transport-Security "max-age=31536000;"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	log {
		output file /var/log/caddy/access.log
	}
}
