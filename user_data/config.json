{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "bot_name": "tradedair",
    "max_open_trades": 3,
    "stake_currency": "USDT",
    "stake_amount": 100,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "dry_run": true,
    "dry_run_wallet": 500,
    "cancel_open_orders_on_exit": false,
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "liquidation_buffer": 0.05,
    "timeframe": "15m",
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "bybit",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [],
        "pair_blacklist": [
            "(USDC|USDE|USDD|USDP|USDS|USD1|FDUSD|TUSD|BUSD|DAI|PYUSD|RLUSD|LUSD|FRAX|GUSD|SUSD|USTC|EURT|EURS|EURI|XAUT|PAXG)/.*",
            ".*(3L|3S|5L|5S|UP|DOWN)/.*",
            "(XRP|ZEC)/USDT:USDT"
        ]
    },
    "pairlists": [
        {
            "method": "VolumePairList",
            "number_assets": 50,
            "sort_key": "quoteVolume",
            "min_value": 0,
            "refresh_period": 1800
        },
        {
            "method": "AgeFilter",
            "min_days_listed": 30
        },
        {
            "method": "PriceFilter",
            "low_price_ratio": 0.01
        },
        {
            "method": "SpreadFilter",
            "max_spread_ratio": 0.005
        },
        {
            "method": "VolatilityFilter",
            "lookback_days": 10,
            "min_volatility": 0.01,
            "max_volatility": 0.75,
            "refresh_period": 3600
        }
    ],
    "telegram": {
        "enabled": true,
        "_comment": "token ve chat_id .env dosyasindan gelir (FREQTRADE__TELEGRAM__*)",
        "allow_custom_messages": true,
        "notification_settings": {
            "status": "on",
            "warning": "on",
            "startup": "on",
            "entry": "on",
            "entry_fill": "on",
            "entry_cancel": "on",
            "exit": {
                "roi": "on",
                "stop_loss": "on",
                "stoploss_on_exchange": "on",
                "custom_exit": "on",
                "force_exit": "on",
                "exit_signal": "on",
                "trailing_stop_loss": "on",
                "liquidation": "on",
                "emergency_exit": "on"
            },
            "exit_fill": "on",
            "exit_cancel": "on",
            "protection_trigger": "on",
            "protection_trigger_global": "on",
            "strategy_msg": "on",
            "show_candle": "off"
        },
        "reload": true,
        "balance_dust_level": 0.01
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": true,
        "_comment": "username, password, jwt_secret_key, ws_token .env dosyasindan gelir",
        "_comment_cors": "Lovable arayuzunu kullanacaksan uygulamanin adresini asagiya ekle",
        "CORS_origins": [
            "http://localhost:8080"
        ]
    },
    "initial_state": "running",
    "force_entry_enable": true,
    "internals": {
        "process_throttle_secs": 5
    }
}
