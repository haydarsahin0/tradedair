{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "bot_name": "tradedair-backtest",
    "max_open_trades": 5,
    "stake_currency": "USDT",
    "stake_amount": 50,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "dry_run": true,
    "dry_run_wallet": 500,
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "liquidation_buffer": 0.05,
    "timeframe": "15m",
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": false,
        "order_book_top": 1,
        "price_last_balance": 0.0
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": false,
        "order_book_top": 1
    },
    "exchange": {
        "name": "bybit",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT:USDT",
            "ETH/USDT:USDT",
            "SOL/USDT:USDT",
            "BNB/USDT:USDT"
        ],
        "pair_blacklist": []
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "_comment_env": [
        "docker-compose, .env icindeki FREQTRADE__TELEGRAM__* ve",
        "FREQTRADE__API_SERVER__* degiskenlerini her calistirmaya enjekte eder.",
        "Bu bloklar dosyada eksikse, enjeksiyon 'enabled' gibi zorunlu alanlari",
        "olmayan yarim bir blok yaratir ve sema dogrulamasi patlar.",
        "Bu yuzden ikisi de burada tam ve KAPALI olarak tanimli."
    ],
    "telegram": {
        "enabled": false,
        "token": "backtest-de-kullanilmaz",
        "chat_id": "0"
    },
    "api_server": {
        "enabled": false,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8080,
        "username": "backtest",
        "password": "backtest-de-kullanilmaz",
        "jwt_secret_key": "backtest-de-kullanilmayan-dolgu-anahtari-0123456789"
    },
    "internals": {
        "process_throttle_secs": 5
    }
}
